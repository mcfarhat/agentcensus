# Loop-test (buyer side) — copy to .env. NEVER commit the real .env.

# Your BUYER test wallet key (the one already funded with tBNB).
PRIVATE_KEY=0x...

NETWORK=bsc-testnet
# Official endpoint - publicnode quotes 0.1 gwei gas which testnet validators drop
RPC_URL=https://bsc-testnet-rpc.publicnode.com
AGENT_URL=http://localhost:8003/erc8183

# The AGENT's wallet address (provider). Leave empty to auto-read from /status.
PROVIDER_ADDRESS=

# Venus account to analyze in the demo job (defaults to the provider address).
# TARGET_ACCOUNT=0x...
