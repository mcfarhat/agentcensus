# AgentCensus Health Factor agent — copy to .env and fill in.
# NEVER commit the real .env.

# --- Wallet (required) ---
# This is the AGENT's wallet (provider role) — a fresh testnet key, NOT your
# buyer/client wallet and NOT any real-funds wallet. First run imports the key
# into an encrypted keystore under ~/.bnbagent/wallets; then you may remove it.
WALLET_PASSWORD=change-me
PRIVATE_KEY=0x...

# --- Network ---
NETWORK=bsc-testnet
RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# --- Storage: local files served from this agent ---
ERC8183_AGENT_URL=http://localhost:8003/erc8183

# --- Price: 0 during the zero-budget loop test; raise later (raw units, 18 dp) ---
ERC8183_SERVICE_PRICE=0
# ERC8183_FUNDED_POLL_INTERVAL=30

# --- Server ---
PORT=8003
AGENT_NAME=AgentCensus Health Factor Monitor
